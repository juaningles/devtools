#!/usr/bin/env bash
# rebuild-container - build a running container from an overlay recipe with docker2wsl's
# container2x.sh (docker, podman or Apple container). The macOS/Linux counterpart of
# bin-win/rebuild-wsl.bat; the recipes are the same files.
#   rebuild-container                      list the recipes in overlays/*/recipes/*.conf
#   rebuild-container NAME [args...]       build recipes/NAME.conf; args go to container2x.sh after
#                                          the recipe's defaults (-n/-u/--force/--dry-run override,
#                                          -b/-p add, --engine/--arch/--commit override)
#   rebuild-container path/to/x.conf [args]
# Recipe keys: image (required), name, user, bootstraps, poststraps, extra, commit, engine
# (docker|podman|apple), arch. location and target are for container2wsl.bat and ignored here.
# Same recipe name in several overlays: the last in name order wins.
# container2x.sh is found via C2X, then PATH, then the docker2wsl clone next to devtools.
set -euo pipefail
SELF="$0"; while [ -L "$SELF" ]; do L=$(readlink "$SELF"); case "$L" in /*) SELF="$L" ;; *) SELF="$(dirname "$SELF")/$L" ;; esac; done
DEVTOOLS="${DEVTOOLS_ROOT:-$(cd "$(dirname "$SELF")/.." && pwd -P)}"

list() {
  echo "Recipes in $DEVTOOLS/overlays/*/recipes/ (name, overlay, image):"
  local f
  for f in "$DEVTOOLS"/overlays/*/recipes/*.conf; do
    [ -f "$f" ] || continue
    printf '  %-12s (%s)  %s\n' "$(basename "$f" .conf)" "$(basename "$(dirname "$(dirname "$f")")")" "$(sed -n 's/^image=//p' "$f" | tr -d '\r' | head -1)"
  done
}
case "${1:-}" in
  ''|--list) list; exit 0 ;;
  -h|--help) sed -n '2,13p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

RECIPE="$1"; shift
FILE=
case "$RECIPE" in
  */*|*.conf) [ -f "$RECIPE" ] || { echo "rebuild-container: recipe file not found: $RECIPE" >&2; exit 2; }; FILE="$RECIPE" ;;
  *) for f in "$DEVTOOLS"/overlays/*/recipes/"$RECIPE".conf; do [ -f "$f" ] && FILE="$f"; done ;;
esac
if [ -z "$FILE" ]; then echo "rebuild-container: no recipe \"$RECIPE\" in $DEVTOOLS/overlays/*/recipes/" >&2; list >&2; exit 2; fi

get() { sed -n "s/^$1=//p" "$FILE" | tr -d '\r' | tail -1; }
image=$(get image); [ -n "$image" ] || { echo "rebuild-container: $FILE has no image= line" >&2; exit 2; }
name=$(get name); name="${name:-$(basename "$FILE" .conf)}"
ARGS=("$image" -n "$name")
v=$(get user); [ -n "$v" ] && ARGS+=(-u "$v")
for b in $(get bootstraps); do ARGS+=(-b "$b"); done
for p in $(get poststraps); do ARGS+=(-p "$p"); done
v=$(get engine); [ -n "$v" ] && ARGS+=(--engine "$v")
v=$(get arch); [ -n "$v" ] && ARGS+=(--arch "$v")
v=$(get commit); [ -n "$v" ] && ARGS+=(--commit "$v")
v=$(get extra); [ -n "$v" ] && read -r -a _extra <<< "$v" && ARGS+=("${_extra[@]}")

C2X="${C2X:-$(command -v container2x.sh 2>/dev/null || true)}"
[ -n "$C2X" ] || { [ -f "$DEVTOOLS/../docker2wsl/container2x.sh" ] && C2X="$DEVTOOLS/../docker2wsl/container2x.sh"; }
[ -n "$C2X" ] || { echo "rebuild-container: container2x.sh not found: set C2X, put it on PATH, or clone docker2wsl next to devtools" >&2; exit 2; }
echo "rebuild-container: recipe $FILE"
echo "rebuild-container: container2x.sh ${ARGS[*]} $*"
exec bash "$C2X" "${ARGS[@]}" "$@"
